{
  "name": "@fluffylabs/jam-search-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for JAM Search",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx ./src/index.ts",
    "dev": "tsx watch ./src/index.ts",
    "db:push": "drizzle-kit push --verbose --strict",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@octokit/rest": "^22.0.1",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.7",
    "fast-xml-parser": "^5.2.3",
    "firecrawl": "^1.25.0",
    "hono": "^4.7.7",
    "matrix-js-sdk": "^39.1.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.97.0",
    "pdfjs-dist": "^5.2.133",
    "postgres": "^3.4.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.19.3",
    "vitest": "^4.0.7"
  },
  "type": "module"
}
