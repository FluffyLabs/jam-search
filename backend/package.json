{
  "name": "@fluffylabs/jam-search-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for JAM Search",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx ./src/index.ts",
    "dev": "EMBEDDINGS_ENABLED=${EMBEDDINGS_ENABLED:-false} tsx watch ./src/index.ts",
    "export": "tsx ./src/scripts/exportToMarkdown.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@octokit/rest": "^22.0.1",
    "@orama/orama": "^3.1.18",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.1",
    "fast-xml-parser": "^5.5.10",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.14",
    "hono-rate-limiter": "^0.5.3",
    "openai": "^6.33.0",
    "turndown": "^7.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2"
  },
  "type": "module"
}
