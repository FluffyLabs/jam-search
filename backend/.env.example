POSTGRES_URL=postgresql://....
OPENAI_API_KEY=sk-...
GITHUB_TOKEN=github_...
DISCORD_TOKEN=...

# Generate document embeddings on startup (requires OPENAI_API_KEY).
# Defaults to "true". `npm run dev` sets this to "false" automatically;
# set to "true" to opt back in when running locally.
EMBEDDINGS_ENABLED=true

# Cheap model used to generate titles for Ask sessions.
# Defaults to anthropic/claude-haiku-4-5.
TITLE_MODEL=anthropic/claude-haiku-4-5
